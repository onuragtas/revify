# Copy to .env and fill in. Secrets live here; pipeline wiring lives in config/config.yaml.

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

# Only needed if config/config.yaml sets wiring.approval: slackReaction.
# Default wiring (consoleApproval) doesn't use these.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Optional — if unset, the Anthropic SDK falls back to an existing
# `ant auth login` / Claude Code session on this machine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
