node_modules/
dist/
*.log

# electron-builder output.
release/

# The API's build output and local databases. The source itself is tracked:
# Jenkins builds it from this checkout, so keeping it out would leave the
# pipeline pointing at a directory that never exists. There is nothing to
# hide in it either — credentials arrive as Jenkins credentials, the
# database lives on the server, and security here comes from the auth code,
# not from nobody being able to read it.
api/build/
api/*.db
api/*.db-shm
api/*.db-wal

# Credentials.
.env

# Everything this tool produces: reviews, answers, notes, queue state.
# It is a verbatim record of internal Jira issues and diffs — the single
# most sensitive thing in the working tree after .env.
data/

# Your team's JQL, project keys and workflow status names, plus the
# switches that decide whether it writes to Jira. Copy config.example.yaml
# to config/config.yaml and edit that.
config/config.yaml

# Half-written files from an interrupted atomic write.
*.tmp

.DS_Store
